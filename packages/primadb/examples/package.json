{
  "name": "primadb-package-examples",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "preinstall": "pnpm --dir .. install --frozen-lockfile && pnpm --dir .. run build",
    "predev": "pnpm --dir .. run build",
    "prebuild": "pnpm --dir .. run build",
    "prepreview": "pnpm --dir .. run build",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke:default": "node ./default-notes/test-smoke.mjs",
    "smoke:indexeddb": "node ./indexeddb-segments/test-growth.mjs",
    "smoke:threaded": "node ./threaded-mesh/test-smoke.mjs",
    "smoke:stream": "node ./binary-stream-room/test-smoke.mjs",
    "smoke:chat": "node ./text-voice-chat/test-smoke.mjs",
    "smoke:moq": "node ./moq-sync/test-smoke.mjs",
    "smoke": "pnpm run smoke:default && pnpm run smoke:indexeddb && pnpm run smoke:threaded && pnpm run smoke:stream && pnpm run smoke:chat && pnpm run smoke:moq"
  },
  "dependencies": {
    "primadb": "link:.."
  },
  "devDependencies": {
    "playwright-core": "^1.55.0",
    "vite": "^7.1.0"
  }
}
