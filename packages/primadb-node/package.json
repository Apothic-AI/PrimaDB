{
  "name": "primadb-node",
  "version": "0.1.1",
  "description": "Native Node.js package for Primadb.",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "license": "Apache-2.0",
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "binding-name.js",
    "README.md",
    "*.node"
  ],
  "scripts": {
    "build": "node ./scripts/build-native.mjs",
    "smoke:core": "pnpm run build && node ./scripts/smoke-core.mjs",
    "smoke:hooks": "pnpm run build && node ./scripts/smoke-hooks.mjs",
    "smoke:relay-server": "pnpm run build && node ./scripts/smoke-relay-server.mjs",
    "smoke:relay": "pnpm run build && node ./scripts/smoke-relay.mjs",
    "smoke:mesh": "pnpm run build && node ./scripts/smoke-mesh.mjs",
    "smoke": "pnpm run smoke:core && pnpm run smoke:hooks && pnpm run smoke:relay-server && pnpm run smoke:relay && pnpm run smoke:mesh",
    "pack:check": "pnpm pack --dry-run"
  },
  "dependencies": {
    "detect-libc": "^2.1.2"
  }
}
