{
  "name": "primadb-browser-package-notes-vite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "preinstall": "pnpm --dir ../../packages/primadb install --frozen-lockfile && pnpm --dir ../../packages/primadb run build",
    "dev": "vite --host 127.0.0.1 --port 4182 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4182 --strictPort",
    "smoke": "node ./scripts/smoke.mjs"
  },
  "dependencies": {
    "primadb": "file:../../packages/primadb"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
